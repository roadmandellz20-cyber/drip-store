# === Supabase (already required) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Anthropic (already required) ===
ANTHROPIC_API_KEY=

# === Telegram — MUGEN OPS Agent ===
TELEGRAM_BOT_TOKEN=            # Get from @BotFather on Telegram
TELEGRAM_WEBHOOK_SECRET=       # Any random string you choose — used to verify webhook requests
TELEGRAM_ADMIN_CHAT_ID=        # Your personal Telegram chat ID — get from @userinfobot on Telegram

# === MUGEN OPS Phase 3 — GitHub code push ===
GITHUB_TOKEN=                  # GitHub personal access token with repo write scope (Settings → Developer settings → Tokens)
GITHUB_OWNER=                  # Your GitHub username e.g. roadmandellz20-cyber
GITHUB_REPO=                   # Repository name e.g. drip-store
